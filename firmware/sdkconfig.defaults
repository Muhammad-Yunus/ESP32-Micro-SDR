# ESP32-Micro-SDR — konfigurasi build (lihat docs/TECH_STACK.md §5)
CONFIG_IDF_TARGET="esp32"

# Real-time & performa
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE=y

# Core 1 didedikasikan streaming audio: audio_feed_task memutar density
# dengan pacing spin per-update (20,8 us) dan hampir tidak pernah memblokir
# saat antrean penuh — IDLE1 memang tidak dijadwalkan. TWDT tetap memantau
# IDLE0 (Core 0, LVGL/UI). Lihat docs/ARCHITECTURE.md §9.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# esp-dsp (choice symbol — 2048 utk FFT spektrum zero-pad)
CONFIG_DSP_MAX_FFT_SIZE_2048=y

# BSP (ESP32-3248S035)
CONFIG_BSP_TFT_ROTATION_270=y
CONFIG_BSP_TFT_SPI_CLK_HZ=80000000
CONFIG_BSP_AMP_DRIVER_DAC=y
CONFIG_BSP_LVGL_TASK_CORE=0
CONFIG_BSP_LVGL_TASK_STACK=12288

# LVGL fonts yang dipakai UI
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# SDR runtime parameters (harus sama dengan default main/Kconfig.projbuild)
CONFIG_SDR_ADC_FS_HZ=48000
CONFIG_SDR_FFT_N=1024
CONFIG_SDR_DISPLAY_SPAN_HZ=50000
CONFIG_SDR_BFO_HZ=1500
CONFIG_SDR_WATERFALL_ROWS=60
CONFIG_SDR_ADC_ATTEN_DB=11
CONFIG_SDR_ADC_POOL_BYTES=8192
CONFIG_SDR_ADC_CONV_FRAME_BYTES=256
CONFIG_SDR_ADC_BLOCK_FRAMES=256
CONFIG_SDR_DEFAULT_LO_HZ=20000000
CONFIG_SDR_LO_MAX_HZ=30000000
CONFIG_SDR_NCO_LIMIT_HZ=2000000
CONFIG_SDR_DEFAULT_VOLUME_PCT=0
CONFIG_SDR_AUDIO_FS_HZ=12000
CONFIG_SDR_AUDIO_BLOCK_SAMPLES=256
CONFIG_SDR_SDM_GPIO=26
CONFIG_SDR_SDM_CARRIER_HZ=10000000
CONFIG_SDR_AUDIO_TONE_HZ=0
CONFIG_SDR_DC_POLE_R=0.996
CONFIG_SDR_CH_LPF_HZ=2700.0
CONFIG_SDR_AUDIO_LPF_HZ=2000.0
CONFIG_SDR_AGC_TARGET=96
CONFIG_SDR_AGC_ATTACK_MS=5.0
CONFIG_SDR_AGC_RELEASE_MS=200.0
CONFIG_SDR_AGC_GAIN_MAX=512.0

# Self-test DSP (I/Q sintetis, tanpa ADC) — build produksi: OFF
CONFIG_SDR_SELFTEST=n
